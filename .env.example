NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/app.db
SESSION_SECRET=
GEMINI_API_KEY=
# Registrierung ist ohne Code zu. Leer lassen = niemand kann sich registrieren.
REGISTER_INVITE_CODE=

# Seed-Nutzer. _EMAIL traegt bei bestehenden Nutzern die Login-Adresse nach.
SEED_USER1_NAME=
SEED_USER1_EMAIL=
SEED_USER1_PASSWORD=
SEED_USER2_NAME=
SEED_USER2_EMAIL=
SEED_USER2_PASSWORD=
SEED_USER3_NAME=
SEED_USER3_EMAIL=
SEED_USER3_PASSWORD=

# Web Push (M15). Keys erzeugen: npx web-push generate-vapid-keys
# Leer lassen = Push komplett aus (App funktioniert normal).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
